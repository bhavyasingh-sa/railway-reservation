# Copy this file to .env and fill in real values. Never commit .env.
DB_HOST=localhost
DB_USER=railway_app
DB_PASSWORD=choose-a-strong-password
DB_NAME=railway_reservation
# 64 random characters: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-random-characters
# Local development only; leave unset in production
APP_DEBUG=1
